# Copy to secrets.yaml beside the device config (gitignored) and fill in.
# ESPHome resolves `!secret <name>` from that file.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
api_encryption_key: "a new 32-byte base64 key"
ota_password: "a new unique password"
ap_password: "a new unique password"
